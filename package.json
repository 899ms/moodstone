{
  "name": "moodstone",
  "version": "0.1.0",
  "description": "Animated, procedurally generated agent avatars for React Native. Nine moods, seven cuts. Rendered with Skia.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./lib/typescript/src/core/index.d.ts",
      "default": "./lib/module/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "prepack": "bob build",
    "example": "npm run start --workspace example",
    "check": "eslint . --max-warnings 0 && prettier --check . && tsc --noEmit",
    "format": "prettier --write . && eslint . --fix"
  },
  "keywords": [
    "react-native",
    "expo",
    "avatar",
    "agent",
    "ai-agent",
    "skia",
    "animation",
    "procedural"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karacca/moodstone.git"
  },
  "author": "Ömer Karaca <omerkaracca@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.7.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@shopify/react-native-skia": "2.6.2",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "typescript": "^5.9.0"
  },
  "workspaces": [
    "example"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
