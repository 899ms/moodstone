{
  "name": "react-native-agent-avatar",
  "version": "0.1.0",
  "description": "Animated, procedurally generated agent avatars for React Native. Nine moods, five cuts, deterministic identity from a name. Rendered with Skia.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./lib/typescript/src/core/index.d.ts",
      "default": "./lib/module/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bob build",
    "prepack": "bob build",
    "harness:build": "bun build dev/harness.ts --outdir dev/dist --target browser",
    "example": "npm run start --workspace example"
  },
  "keywords": [
    "react-native",
    "expo",
    "avatar",
    "agent",
    "ai-agent",
    "skia",
    "animation",
    "procedural"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karacca/react-native-agent-avatar.git"
  },
  "author": "Ömer Karaca <omerkaracca@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "^5.9.0",
    "@types/bun": "^1.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "workspaces": [
    "example"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
